  "warmup_steps": 200,
  "weight_decay": 1e-10,
  "gradient_clip": 10.0,
  "value": {
    "horizon_s": 60,
    "train_vision": true,
    "head_lr_scale": 10.0,
    "advantage_steps": 50,
    "positive_share": 0.4,
    "label_batch_size": 64
  },
  "data_scope": "RECAP value function (so101vla/value.py): all 538 episodes of so101_recap_v1 with an outcome (demos, corrections, real rollouts with success labels, twin expert); validation = the 11 pilot_v3 validation demos + 42 held-out rollout/twin episodes",
  "schedule_source": "first value run: lr 2e-5 (VLM incl. vision encoder) and 10x for the new head, warmup 200, cosine to 2e-6, 4000 steps of 32, early stop after 6 evaluations without a lower validation cross-entropy"
