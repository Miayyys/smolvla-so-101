{
  "model_dir": "artifacts/smolvla_base",
  "vlm_assets_dir": "artifacts/transfer/smolvlm2_assets",
  "dataset_root": "artifacts/datasets/so101_recap_v2_512",
  "cache_dirs": {
    "observation.images.top": "/dev/shm/recap_v2",
    "observation.images.wrist": "/root/sj-fs/cache_recap_v2"
  },
  "prepare_workers": 16,
  "seed": 42,
  "camera_map": {
    "observation.images.camera1": "observation.images.top",
    "observation.images.camera2": "observation.images.wrist"
  },
  "image_size": 512,
  "cache_resize": true,
  "stats_from": "runs/so101_pilot_v2/stats.json",
  "partition": "configs/so101_recap_v3_partition_policy.json",
  "output": "runs/so101_recap_v3",
  "batch_size": 16,
  "gradient_accumulation": 4,
  "steps": 20000,
  "learning_rate": 0.0001,
  "minimum_learning_rate": 2.5e-06,
  "warmup_steps": 1000,
  "weight_decay": 1e-10,
  "gradient_clip": 10.0,
  "eval_every": 1000,
  "minimum_steps": 20000,
  "patience_evaluations": 1000,
  "validation_frames_per_episode": 10,
  "save_last": true,
  "evaluation": "real_offline",
  "train_vlm": true,
  "trim_static_head": {
    "tolerance_deg": 2.0,
    "keep_frames": 5
  },
  "trim_static_tail": {
    "tolerance_deg": 2.0,
    "keep_frames": 15
  },
  "correction_repeat": 1,
  "advantage": {
    "labels": "runs/so101_value_v2_labels/labels.npz",
    "dropout": 0.3
  },
  "training_scope": "Full fine-tuning from official smolvla_base, with existing RECAP labels; fresh optimizer.",
  "schedule_source": "User-approved new run: 20000 steps, effective batch 64, lr 1e-4, warmup 1000, cosine to 2.5e-6.",
  "data_scope": "Existing RECAP v2 dataset and labels. Exactly 50:50 real/twin per microbatch; only human correction frames have 2x within-real weight. Original real holdouts preserved; 40 clean twin v2/v2b episodes held out. Image caches verified and reused.",
  "cache_from": "runs/so101_recap_v2",
  "validation_metric": "real_twin_mean",
  "sampling": {
    "real_fraction": 0.5,
    "human_correction_weight": 2.0
  }
}
